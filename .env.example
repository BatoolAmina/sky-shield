# Copy to .env and replace these values before sharing or deploying.
PORT=4000
# Generate a private value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
INSTRUCTOR_CODE=replace-with-a-private-instructor-code
# Leave blank to disable admin sign-up.
ADMIN_CODE=
# Optional. Configure a Google OAuth Web client to enable Google sign-in.
GOOGLE_CLIENT_ID=
# Optional MongoDB connection string. Leave blank to use the JSON file store.
MONGO_URI=
DATA_FILE=data/db.json
